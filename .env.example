# ---------------------------------------------------------------------------
# Copie para .env (local) ou cadastre como Environment Variables no Render.
# ---------------------------------------------------------------------------

# Obrigatório. String de conexão do Neon (Dashboard > Connection string > psql).
# Precisa terminar com ?sslmode=require
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Primeiro administrador. Criado sozinho no primeiro boot; depois pode remover.
ADMIN_NOME=Alan
ADMIN_EMAIL=alandiegolimaneves@gmail.com
ADMIN_SENHA=troque-esta-senha-agora

# Sessão
SESSION_TTL_HORAS=12
COOKIE_SEGURO=1

# Origens liberadas para o front (separadas por vírgula).
# Se servir os painéis pelo próprio Render, pode deixar vazio.
CORS_ORIGINS=

# --------------------------- CREDENCIAIS DAS FONTES ------------------------
# Todas gratuitas. Sem elas o conector aparece no painel como indisponível.

# DataJud / CNJ — chave pública publicada na documentação do CNJ.
# https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_API_KEY=

# Portal da Transparência — cadastro gratuito gera a chave por e-mail.
# https://api.portaldatransparencia.gov.br/swagger-ui/index.html
PORTAL_TRANSPARENCIA_KEY=

# Base pública de CNPJ + sócios da Receita, num Postgres SEPARADO.
# Deixe vazio para manter o cruzamento de sócios desligado.
# A base passa de 100 GB e NÃO cabe no Neon gratuito — ver db/002_socios.sql.
SOCIOS_DATABASE_URL=

# --------------------------- FERRAMENTAS LOCAIS ----------------------------
# 1 = habilita maigret / holehe / phoneinfoga (exige a imagem Docker).
# 0 = só conectores HTTP (use quando rodar sem Docker).
FERRAMENTAS_LOCAIS=1

# Trava de memória do maigret no free tier do Render (512 MB).
MAIGRET_TOP_SITES=50
MAIGRET_TIMEOUT=15
